---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Lightbox from '../../components/Lightbox.astro';
import { cms, bestImageUrl, filteredGalleryImages } from '../../lib/cms';

// Fetch details (they carry the photo galleries; the list endpoint does not).
const exhibitions = await cms.exhibitions();
const details = await Promise.all(
  exhibitions.map((ex) => cms.exhibition(ex.slug).catch(() => ex))
);

function formatDate(iso: string | null): string {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

// Convert a YouTube/Vimeo URL into an embeddable URL for the feature video.
// Handles youtu.be/, youtube.com/watch?v=, and vimeo.com/ URLs.
function videoEmbedUrl(u: string): string {
  if (!u) return '';
  const youtuBe = u.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=)([\w-]+)/);
  if (youtuBe) return `https://www.youtube.com/embed/${youtuBe[1]}`;
  const vimeo = u.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return u;
}
---

<Layout title="Exhibitions — This is a House Gallery" bodyClass="exhibitions-index">
  <div class="body">
      <PageHeader title="Exhibitions" />

      <div class="exhibitions-listing">
      {details.map((ex) => {
        const gallery = filteredGalleryImages(ex);
        const imgUrl = bestImageUrl(ex.listing_image, { max: 400 }) ??
          (gallery[0] ? bestImageUrl(gallery[0], { max: 400 }) : undefined);
        return (
          <div id={ex.title.toLowerCase().replace(/\s+/g, '-')} class="exhibition-listing-item exhibition-title">
            <a href={`/exhibitions/${ex.slug}/`} class="exhibition-header-link">
              <section class="exhibition-header">
                <h3>{formatDate(ex.start_date)}</h3>
                <section>
                  <h2>{ex.title}</h2>
                  <section class="exhibition-header__artists">
                    {ex.artists.map((a) => (
                      <p>{a.name}</p>
                    ))}
                  </section>
                </section>
              </section>
            </a>

            {(() => {
                          const embed = videoEmbedUrl(ex.video_embed_url || '');
                          if (embed) {
                            return (
                              <div class="exhibition-feature-video">
                                <div class="video-container video-responsive">
                                  <iframe
                                    src={embed}
                                    title={ex.title}
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen
                                  ></iframe>
                                </div>
                              </div>
                            );
                          }
                          return gallery.length > 0 ? (
                          <div class="exhibition-feature-gallery" data-gallery-id={ex.title.toLowerCase().replace(/\s+/g, '-')}>
                            <div class="gallery-container gallery-columns-container masonry">
                              <div class="gallery-images">
                                {gallery.map((img, i) => (
                                  <button
                                    class="gallery-lightbox-item"
                                    data-media-type="image"
                                    data-media-src={bestImageUrl(img, { max: 1600 }) ?? img.file_url ?? ''}
                                    data-thumbnail-src={bestImageUrl(img, { max: 400 }) ?? img.file_url ?? ''}
                                    data-caption={img.title || ex.title}
                                    data-image-type="exhibition"
                                    data-index={i}
                                    aria-label={`View ${img.title || ex.title} in lightbox`}
                                  >
                                    <img
                                      src={bestImageUrl(img, { max: 400 })}
                                      alt={img.title || ex.title}
                                      width={img.width || undefined}
                                      height={img.height || undefined}
                                      loading="lazy"
                                      decoding="async"
                                      class="gallery-single-image"
                                    />
                                  </button>
                                ))}
                              </div>
                            </div>
                          </div>
                        ) : null;
                        })()}
          </div>
        );
      })}
          </div>
        </div>

        <Lightbox />
      </Layout>

      <script>
        import { UnifiedGalleryLightbox } from '../../lib/lightbox';
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => new UnifiedGalleryLightbox().init());
        } else {
          new UnifiedGalleryLightbox().init();
        }
      </script>
